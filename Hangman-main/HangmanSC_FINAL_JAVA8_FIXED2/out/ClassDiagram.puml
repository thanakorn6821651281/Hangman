@startuml
skinparam classAttributeIconSize 0

package Domain {
  enum Difficulty
  enum GameStatus
  class Word
  class Player
  class HangmanGame
  class ScoreEntry
}

package Part_Data {
  interface WordRepository
  class CsvWordRepository
  interface ScoreRepository
  class CsvScoreRepository
}

package Part_Service {
  class WordService
  class GameService
  class LeaderboardService
  class AppServices
}

package "Part_UI / GUI" {
  class Main
  class HomeUI
  class LoginUI
  class DifficultyUI
  class GameUI
  class ResultUI
  class LeaderboardUI
}

WordRepository <|.. CsvWordRepository
ScoreRepository <|.. CsvScoreRepository

CsvWordRepository --> Word
CsvScoreRepository --> Player

WordService --> WordRepository
WordService --> Difficulty
GameService --> WordService
GameService --> HangmanGame
GameService --> Difficulty
LeaderboardService --> ScoreRepository
LeaderboardService --> Player

HangmanGame --> Word
HangmanGame --> Difficulty
HangmanGame --> GameStatus

AppServices --> GameService
AppServices --> LeaderboardService

HomeUI --> LoginUI
HomeUI --> LeaderboardUI
LoginUI --> Player
LoginUI --> DifficultyUI
DifficultyUI --> GameUI
GameUI --> HangmanGame
GameUI --> GameService
GameUI --> ResultUI
ResultUI --> GameUI
ResultUI --> HomeUI
LeaderboardUI --> LeaderboardService
Main --> HomeUI
@enduml
